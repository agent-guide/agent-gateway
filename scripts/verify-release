#!/bin/sh

set -eu

format_check() {
	unformatted=$(git ls-files '*.go' ':!third_party/**' | xargs gofmt -l)
	if [ -n "$unformatted" ]; then
		echo "The following tracked Go files need formatting:" >&2
		echo "$unformatted" >&2
		return 1
	fi
}

race_check() {
	# eino-ext/claude v0.1.25 has a known race inside ChatModel.Stream.
	# Keep race coverage for every other package until upstream releases a fix.
	go list ./... \
		| grep -v '/pkg/llm/provider/anthropic$' \
		| xargs go test -race
}

case "${1:-all}" in
	format)
		format_check
		;;
	all)
		format_check
		go mod verify
		go test ./...
		race_check
		go vet ./...
		make build
		;;
	*)
		echo "usage: $0 [all|format]" >&2
		exit 2
		;;
esac
